{
  "name": "mishop-next",
  "version": "1.0.0",
  "private": false,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "vp lint",
    "prepare": "vp config",
    "bullmq": "tsup scripts/start-bullmq.ts --format cjs --out-dir scripts/dist && node scripts/dist/start-bullmq.js",
    "socket": "tsup scripts/start-socket.ts --format cjs --out-dir scripts/dist && node scripts/dist/start-socket.js",
    "dev:all": "concurrently 'vp run dev' 'vp run bullmq' 'vp run socket'",
    "start:all": "concurrently 'vp run start' 'vp run bullmq' 'vp run socket'"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.66.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "decimal.js": "^10.6.0",
    "deepmerge": "^4.3.1",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "ioredis": "^5.8.2",
    "lodash": "^4.17.21",
    "motion": "^12.23.26",
    "mysql2": "^3.16.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.6.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rtl-detect": "^1.1.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^13.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/lodash": "^4.17.21",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/rtl-detect": "^1.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.8.0",
      "onFail": "download"
    }
  }
}
