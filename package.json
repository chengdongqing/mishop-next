{
  "name": "mishop-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "bullmq": "tsup scripts/start-bullmq.ts --format cjs --out-dir scripts/dist && node scripts/dist/start-bullmq.js",
    "socket": "tsup scripts/start-socket.ts --format cjs --out-dir scripts/dist && node scripts/dist/start-socket.js",
    "dev:all": "concurrently 'npm run dev' 'npm run bullmq' 'npm run socket'",
    "start:all": "concurrently 'npm run start' 'npm run bullmq' 'npm run socket'"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.66.1",
    "dayjs": "^1.11.19",
    "decimal.js": "^10.6.0",
    "deepmerge": "^4.3.1",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "ioredis": "^5.8.2",
    "lodash": "^4.17.21",
    "motion": "^12.23.26",
    "mysql2": "^3.16.0",
    "next": "^16.1.0",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.6.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rtl-detect": "^1.1.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^13.0.0",
    "zod": "^4.2.1",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/lodash": "^4.17.21",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/rtl-detect": "^1.0.3",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.0.10",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none",
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  }
}
